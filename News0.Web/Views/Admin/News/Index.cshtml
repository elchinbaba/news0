@model List<News0.Web.Models.NewsViewModel>

@{
    ViewData["Title"] = "News Website";
    Layout = "_Layout";
}

<!-- Main Content -->
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <a asp-action="NewsCreate" class="btn btn-primary mt-3 list-group-item list-group-item-action">ADD NEWS</a>

            <!-- News Articles -->
            @{
                foreach (NewsViewModel news in Model)
                {
                    <div class="card mb-4">
                        <img src="https://via.placeholder.com/400x200" class="card-img-top" alt="News Image">
                        <div class="card-body">
                            <h5 class="card-title">@news.Title<span class="float-right">@news.Language</span></h5>
                            <p class="card-text">@news.Title</p>
                            <a asp-action="NewsDetails" asp-route-id="@news.Id" class="btn btn-primary">Read More</a>
                            <a asp-action="NewsDelete" class="btn btn-danger float-right">Delete</a>
                            <a asp-action="NewsEdit" class="btn btn-primary float-right">Edit</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
