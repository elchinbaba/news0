@model List<News0.Web.Models.Post.PostViewModel>

@{
    ViewData["Title"] = "News Website";
    Layout = "_Layout";
}

<!-- Main Content -->
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <a asp-action="PostCreate" class="btn btn-primary mt-3 list-group-item list-group-item-action">ADD NEWS</a>

            <!-- News Articles -->
            @{
                foreach (News0.Web.Models.Post.PostViewModel post in Model)
                {
                    <div class="card mb-4">
                        <img src="https://via.placeholder.com/400x200" class="card-img-top" alt="News Image">
                        <div class="card-body">
                            <h5 class="card-title">@post.Title<span class="float-right">@post.Language</span></h5>
                            <p class="card-text">@post.Content</p>
                            <a asp-action="PostDetails" asp-route-id="@post.Id" class="btn btn-primary">Read More</a>
                            <a asp-action="PostDelete" class="btn btn-danger float-right">Delete</a>
                            <a asp-action="PostEdit" class="btn btn-primary float-right">Edit</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
