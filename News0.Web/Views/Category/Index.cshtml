@{
    <div asp-validation-summary="All"></div>

    <form asp-controller="Category" asp-action="Create" method="post">
        Category Name: <input asp-for="Name" /><br />
        <span asp-validation-for="Name"></span><br />
        <button type="submit">Create</button>
    </form>
}